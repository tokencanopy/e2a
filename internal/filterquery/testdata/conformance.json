  {"name": "single has", "q": "tags:sale", "ast": "(tags : sale)", "sql": "(p.tags @> $1)", "args": [["sale"]]},
  {"name": "substring", "q": "name:widget", "ast": "(name : widget)", "sql": "(p.name ILIKE $1 ESCAPE '\\')", "args": ["%widget%"]},
