{
  "name": "@e2a/ui",
  "version": "0.1.0",
  "description": "Loft — the e2a design system. Standalone, buildable React component library.",
  "license": "Apache-2.0",
  "author": "TokenCanopy <josh@tokencanopy.com>",
  "homepage": "https://github.com/tokencanopy/e2a/tree/main/design-system",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokencanopy/e2a",
    "directory": "design-system"
  },
  "bugs": "https://github.com/tokencanopy/e2a/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
