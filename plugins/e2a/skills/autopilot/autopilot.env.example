# e2a autopilot — copy to ~/.e2a-autopilot.env (chmod 600) and fill in, or run
# `autopilot.sh setup` to generate this file interactively (recommended — it
# also mints the listener key and forward token for you).

# --- e2a credential (a listener-dedicated agent-scoped key, NOT an account key) ---
export E2A_API_KEY="e2a_agt_..."
export E2A_AGENT_EMAIL="persona@yourdomain.com"   # must already exist (e2a agents create)

# --- local receiver security ---
# Random secret shared between `e2a listen --forward` and the local HTTP
# receiver. Generate with: python3 -c 'import secrets; print(secrets.token_hex(24))'
export E2A_AUTOPILOT_FORWARD_TOKEN="..."
export E2A_AUTOPILOT_PORT="8991"                  # loopback only — never expose this port

# --- trust model ---
# Comma-separated addresses whose mail auto-triggers a session. Include your
# own address(es) and any peer agent personas that legitimately email this
# one. Anything else is logged and left for a human to triage — see SKILL.md.
export E2A_AUTOPILOT_ALLOWLIST="you@example.com,peer-agent@yourdomain.com"
export E2A_AUTOPILOT_HUMAN="you@example.com"      # CC'd on every autopilot reply

# --- runtime ---
export E2A_AUTOPILOT_RUNTIME="claude"             # claude | codex | kimi
export E2A_AUTOPILOT_RUNTIME_BIN="/absolute/path/to/claude"  # resolve shims: readlink -f $(which claude)
export E2A_AUTOPILOT_WORKDIR="/absolute/path/to/workspace"
# export E2A_AUTOPILOT_CHARTER="/absolute/path/to/CHARTER.md"   # optional context file, read first
# export E2A_AUTOPILOT_SETTINGS="/absolute/path/to/headless-settings.json"  # Claude Code only; strongly recommended — see headless-settings.claude.example.json

# --- optional tuning (defaults shown) ---
# export E2A_AUTOPILOT_RUN_TIMEOUT_MS="1800000"        # 30 min per spawned session
# export E2A_AUTOPILOT_BOUNCE_INTERVAL_MS="900000"     # 15 min forced reconnect
# export E2A_AUTOPILOT_RECONCILE_INTERVAL_MS="600000"  # 10 min independent unread poll
# export E2A_URL="https://e2a.dev"                     # self-host: your e2a deployment root
# export E2A_CLI="node /path/to/cli/dist/bin/e2a.js"   # override the e2a CLI resolution
