# Backend (Go) env vars. Copy to .env and fill in values for local dev.
#
# docker-compose passes everything from .env to the e2a service via
# env_file. cmd/e2a/main.go also calls godotenv.Load() so a binary run
# directly from this directory will see the same vars.
#
# .env is gitignored — do not commit secrets.

# ── Required ────────────────────────────────────────────────────────
# Postgres connection. Intentionally commented out: this value is
# host-networking oriented — it is correct for a binary run directly on
# this machine (`make run`, connecting to the compose Postgres via its
# host port mapping), but docker compose interpolates any ACTIVE value
# here into the e2a container's environment, where localhost:5433 is
# the container itself and nothing is listening — an active line here
# breaks `docker compose up -d`. Compose supplies its own
# container-correct default (postgres:5432), and host-binary runs don't
# need this either: config.example.yaml's database.url carries the same
# default. Uncomment only if you run the binary on the host against a
# Postgres that ISN'T the compose one.
# E2A_DATABASE_URL=postgres://e2a:e2a@localhost:5433/e2a?sslmode=disable

# Deployment master HMAC secret for approval/magic-link tokens and internal
# key derivation. Webhook delivery signatures use each subscription's whsec_
# secret instead. Must be >=32 bytes even in development (the OAuth token
# signer derives its key from it unconditionally). Production additionally
# rejects this exact placeholder value.
# Generate with: openssl rand -hex 32
E2A_HMAC_SECRET=change-me-in-production-this-is-not-a-real-secret

# ── Dashboard sign-in (Google OAuth) ────────────────────────────────
# Required if you want the Next.js dashboard's "Sign in with Google"
# button to work. The CLI/SDKs use API keys and don't need this.
#
# To set up:
#   1. https://console.cloud.google.com/apis/credentials → Create
#      OAuth client ID → Application type "Web application"
#   2. Add authorized redirect URIs:
#        http://localhost:3000/api/auth/callback   (Next dev / docker compose web)
#        http://localhost:8080/api/auth/callback   (binary run directly)
#        https://your-deployment.example.com/api/auth/callback  (prod)
#   3. Copy the client ID and client secret below
E2A_GOOGLE_CLIENT_ID=
E2A_GOOGLE_CLIENT_SECRET=

# OAuth callback URL the backend constructs for Google. Must match one
# of the authorized redirect URIs in the Google client config above.
# Defaults to http://localhost:3000/api/auth/callback if unset.
E2A_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback

# ── Optional ────────────────────────────────────────────────────────
# Externally visible base URL of the API. Required for HITL magic-link
# emails to render absolute URLs. Empty disables HITL email notifier.
E2A_PUBLIC_URL=http://localhost:8080

# Shared mail domain for slug-based agent registration. Empty disables
# the slug shortcut. agents.localhost is a fine demo value: localhost
# never resolves externally so no real mail will arrive, but the
# `e2a agents register <slug>` flow still works against the API.
E2A_SHARED_DOMAIN=agents.localhost

# Outbound SMTP relay (only needed if you want agents to send mail).
# Most operators point at SES, Postmark, Mailgun, etc.
E2A_OUTBOUND_SMTP_HOST=
E2A_OUTBOUND_SMTP_PORT=587
E2A_OUTBOUND_SMTP_USERNAME=
E2A_OUTBOUND_SMTP_PASSWORD=
E2A_OUTBOUND_SMTP_FROM_DOMAIN=

# Per-message usage tracking. Only useful for hosted deployments doing
# billing reconciliation; self-hosters typically don't need it.
# Intentionally commented out: unset means false for host-binary runs
# (the config default), while docker compose's own demo default — true,
# so the dashboard stats strip shows real numbers on first
# `docker compose up` — survives. An active `false` here would be
# interpolated into the container and silently override that default.
# E2A_USAGE_TRACKING=false

# In-app feedback → GitHub issue (dashboard's /feedback page, POST
# /api/feedback). That endpoint is UNAUTHENTICATED (IP-rate-limited only), so
# leave this whole block unset unless you actually want it: a credential
# configured here without GITHUB_FEEDBACK_REPO refuses to file anything
# (logs why) rather than defaulting to the upstream tokencanopy/e2a repo — a
# self-hosted deployment's own GitHub credential must never be used to file
# issues on someone else's tracker with your users' emails in the body.
# Static personal-access-token auth:
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=
# Alternative: GitHub App auth (all three required together; a partial set
# falls back to GITHUB_FEEDBACK_TOKEN with a loud log line):
GITHUB_FEEDBACK_APP_ID=
GITHUB_FEEDBACK_APP_INSTALLATION_ID=
GITHUB_FEEDBACK_APP_PRIVATE_KEY=
# Optional second delivery channel: email a copy of each submission via the
# platform relay (comma-separated; empty means off).
FEEDBACK_NOTIFY_TO=
FEEDBACK_NOTIFY_CC=

# Content screening (prompt-injection / phishing detection on inbound and
# outbound mail). Off by default even here — this is the deployment-level
# master switch; each agent's scan_sensitivity must also be set above "off"
# via PUT /v1/agents/{email}/protection before scanning actually runs for
# that agent. See docs/deployment.md and config.example.yaml's "Content
# screening (piguard)" section for the full picture (Gemini detector, etc).
E2A_CONTENT_SCAN_ENABLED=false
